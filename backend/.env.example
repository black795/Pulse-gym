# Copia este archivo como ".env" y ajusta los valores.
ENTORNO=desarrollo
# Por defecto usa SQLite (cero instalación). Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://pulse:pulse@localhost:5432/pulse_gym
DATABASE_URL=sqlite:///./pulse_gym.db
# Genera una clave real con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-en-produccion
ACCESS_TOKEN_MINUTOS=60
CORS_ORIGINS=http://localhost:5173
# Crea usuarios de prueba (Carlos, Pati, Javier, Daniela...) al iniciar
SEED_DEMO=true
DEMO_PASSWORD=Pulse2026!
